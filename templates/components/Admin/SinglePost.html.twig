{% props post %}
<div class="card-body">
    <div class="d-flex justify-content-between">
        <h2>{{ post.title }}</h2>
        <span class="badge">{{ post.status.label }}</span>
    </div>
    <div class="mt-3">{{ post.content|nl2br }}</div>
    {% for tag in post.tags %}
        <span class="badge bg-secondary">{{ tag.name }}</span>
    {% endfor %}
</div>
